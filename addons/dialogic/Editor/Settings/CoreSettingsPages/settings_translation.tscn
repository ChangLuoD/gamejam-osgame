[node name="OutputModeTooltip" parent="TranslationSettings/VBoxContainer/Grid/VBox2" unique_id=1226526686 instance=ExtResource("2_k2lou")]
layout_mode = 2
tooltip_text = "决定要创建多少个 CSV 文件。

• \"按类型\"：每种资源类型各用一个 CSV 文件：时间线、角色和术语表。
例如，10 条时间线会合并到 1 个 CSV 文件中。

• \"按文件\"：每个资源文件各用一个 CSV 文件。
例如，10 条时间线会产生 10 个 CSV 文件。

\"按文件\" 选项会使用 \"输出位置\"，而 \"按类型\" 则始终使用翻译文件夹。"
texture = null
hint_text = "决定要创建多少个 CSV 文件。

• \"按类型\"：每种资源类型各用一个 CSV 文件：时间线、角色和术语表。
例如，10 条时间线会合并到 1 个 CSV 文件中。

• \"按文件\"：每个资源文件各用一个 CSV 文件。
例如，10 条时间线会产生 10 个 CSV 文件。

\"按文件\" 选项会使用 \"输出位置\"，而 \"按类型\" 则始终使用翻译文件夹。"

