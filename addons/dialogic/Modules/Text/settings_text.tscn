[node name="Title" type="Label" parent="VBoxContainer/HBoxContainer AutoSkip" unique_id=1232601655]
layout_mode = 2
theme_type_variation = &"DialogicSettingsSection"
text = "自动跳过"

[node name="HintTooltip" parent="VBoxContainer/HBoxContainer AutoSkip" unique_id=193066646 instance=ExtResource("3_s7xhj")]
layout_mode = 2
tooltip_text = "自动跳过是指自动跳过时间线事件，直到下一个未读的文本事件或需要用户输入的事件（例如选项、等待输入和文本输入）。

你可以通过代码启用自动跳过：
Dialogic.Inputs.auto_skip.enabled = true

默认情况下，自动跳过会在用户输入时取消。
你可以调用以下代码禁用该行为：
Dialogic.Inputs.auto_skip.disable_on_user_input = false"
texture = null
hint_text = "自动跳过是指自动跳过时间线事件，直到下一个未读的文本事件或需要用户输入的事件（例如选项、等待输入和文本输入）。

你可以通过代码启用自动跳过：
Dialogic.Inputs.auto_skip.enabled = true

默认情况下，自动跳过会在用户输入时取消。
你可以调用以下代码禁用该行为：
Dialogic.Inputs.auto_skip.disable_on_user_input = false"

