[node name="Title" type="Label" parent="VBoxContainer/HBoxContainer AutoAdvance" unique_id=421193728]
layout_mode = 2
theme_type_variation = &"DialogicSettingsSection"
text = "自动前进"

[node name="HintTooltip" parent="VBoxContainer/HBoxContainer AutoAdvance" unique_id=1217785063 instance=ExtResource("3_s7xhj")]
layout_mode = 2
tooltip_text = "自动前进是指在文本显示完成后自动推进到下一事件，通常是在一段延迟之后。

你可以用以下任一方式在代码中启用自动前进：
- Dialogic.Inputs.auto_advance.enabled_until_user_input = true
- Dialogic.Inputs.auto_advance.enabled_until_next_event = true
- Dialogic.Inputs.auto_advance.enabled_forced = true
这些标志会累加，因此只要其中任一为 true，就会发生自动前进。
除非禁用了手动前进，否则玩家随时可以跳过自动前进的等待时间。

自动前进会等待语音播放完毕。该行为可以通过代码禁用。 "
texture = null
hint_text = "自动前进是指在文本显示完成后自动推进到下一事件，通常是在一段延迟之后。

你可以用以下任一方式在代码中启用自动前进：
- Dialogic.Inputs.auto_advance.enabled_until_user_input = true
- Dialogic.Inputs.auto_advance.enabled_until_next_event = true
- Dialogic.Inputs.auto_advance.enabled_forced = true
这些标志会累加，因此只要其中任一为 true，就会发生自动前进。
除非禁用了手动前进，否则玩家随时可以跳过自动前进的等待时间。

自动前进会等待语音播放完毕。该行为可以通过代码禁用。 "

